# systemd user unit. Install with:
#   ln -s /data/src/reader-thing/deploy/reader-thing.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now reader-thing
# Needs lingering (`loginctl enable-linger`) to start at boot without a login.

[Unit]
Description=reader-thing read-it-later service
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/data/src/reader-thing
# Config (S3, auth token, HOST/PORT) comes from .env in the working directory.
ExecStart=/home/tahnok/.local/bin/uv run --frozen reader-thing serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
