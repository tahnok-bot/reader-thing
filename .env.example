# Copy to .env and fill in.

DATABASE_PATH=reader.db

# Where `reader-thing serve` listens.
HOST=0.0.0.0
PORT=8000

# S3-compatible object storage (example: a self-hosted Garage instance).
S3_BUCKET=reader
S3_ENDPOINT_URL=http://localhost:3900
AWS_ACCESS_KEY_ID=GKyour-garage-access-key-id
AWS_SECRET_ACCESS_KEY=your-garage-secret-access-key
AWS_REGION=garage

# Shared secret. Leave empty to disable auth (local dev only).
AUTH_TOKEN=change-me
